<UserControl x:Class="DiffFinder.SelectShelvesetTeamExplorerView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mvvm="clr-namespace:Microsoft.TeamFoundation.MVVM;assembly=Microsoft.TeamFoundation.Controls"
      xmlns:tfscontrols="clr-namespace:Microsoft.TeamFoundation.Controls.WPF;assembly=Microsoft.TeamFoundation.Controls"      
      xmlns:tfsteamexplorer="clr-namespace:Microsoft.TeamFoundation.Controls.WPF.TeamExplorer.Framework;assembly=Microsoft.TeamFoundation.Controls"      
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="300"
      xmlns:extensions="clr-namespace:DiffFinder"
      DataContext="{Binding Source={RelativeSource Self}}">
  <UserControl.Resources>
    <ResourceDictionary Source="../Resources/ResourceDictionary.xaml"/>
  </UserControl.Resources>

  <UserControl.MaxHeight>
    <MultiBinding Converter="{StaticResource ResourceKey=MaxHeightConverter }">
      <Binding Path="ActualHeight" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type tfsteamexplorer:PageScrollViewer}}" Mode="OneWay"/>
    </MultiBinding>
  </UserControl.MaxHeight>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <WrapPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Stretch" Name="SelectShelvesetPanel">
      <ComboBox Name="FirstShelvesetUserComboBox" Style="{StaticResource ComboBoxStyle}" ItemTemplate="{StaticResource UserItemTemplate}" ItemsSource="{Binding Path=ParentSection.Users}" SelectedItem="{Binding Path=ParentSection.FirstUserAccountName, Mode=TwoWay}" IsTextSearchEnabled="True" SelectionChanged="ShelvesetUserComboBox_SelectionChanged" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type WrapPanel}, Mode=FindAncestor}}" HorizontalAlignment="Stretch" Height="25">
        <ComboBox.ToolTip>
          <TextBlock>Select the shelveset owner. Type the first letters of a name to select it.</TextBlock>
        </ComboBox.ToolTip>
      </ComboBox>
      <ComboBox Name="SecondShelvesetUserComboBox" Style="{StaticResource ComboBoxStyle}" ItemTemplate="{StaticResource UserItemTemplate}" ItemsSource="{Binding Path=ParentSection.Users}" SelectedItem="{Binding Path=ParentSection.SecondUserAccountName, Mode=TwoWay}" IsTextSearchEnabled="True" SelectionChanged="ShelvesetUserComboBox_SelectionChanged" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type WrapPanel}, Mode=FindAncestor}}" HorizontalAlignment="Stretch" Height="25">
        <ComboBox.ToolTip>
          <TextBlock>Select a second shelveset owner (If you are comparing shelvesets of two users)</TextBlock>
        </ComboBox.ToolTip>
      </ComboBox>
      <!-- a DockPanel rather than letting the buttons flow in the WrapPanel, which packs its children to
           the left and ignores their HorizontalAlignment, so nothing can sit against the right edge -->
      <DockPanel LastChildFill="False" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type WrapPanel}, Mode=FindAncestor}}">
        <Button Name="ListButton" DockPanel.Dock="Left" Width="35" ToolTip="List all changesets for selecte users" Height="10"  Content="List" Click="ListButton_Click" Margin="5"/>
        <Button Name="CompareButtons" DockPanel.Dock="Left" Width="Auto" ToolTip="Diff between the two selected shelvesets" Height="10"  Content="Diff Shelvesets" Click="CompareButtons_Click" Margin="5"/>
        <Button Name="CompareWithPendingChange" DockPanel.Dock="Left" Width="Auto" ToolTip="Diff between the selected shelveset with Pending change" Height="10"  Content="Diff Pending" Click="CompareWithPendChangeButtons_Click" Margin="5"/>
        <Button Name="RefreshUsersButton" DockPanel.Dock="Right" Width="Auto" ToolTip="Reload the list of users from the server" Height="10"  Content="Refresh Users" Click="RefreshUsersButton_Click" Margin="5"/>
      </DockPanel>
      <WrapPanel Orientation="Horizontal" Margin="0,10" HorizontalAlignment="Stretch" Visibility="Hidden" Name="ErrorPanel" Background="LightYellow" >
        <TextBlock HorizontalAlignment="Stretch" Name="ErrorText" Foreground="Black"/>
      </WrapPanel>
    </WrapPanel>
    
    <DockPanel Grid.Row="2" HorizontalAlignment="Stretch" Name="ShelvesetComparisonPanel" LastChildFill="True">
      <Line Stretch="Fill" Stroke="Gray" X2="1" Height="20" DockPanel.Dock="Top"/>

      <!-- the shelvesets are listed a page at a time, so that the details of a shelveset, such as its
           reviewers, are only read once its page is shown. The selection is kept across the pages. -->
      <DockPanel Name="ShelvesetPagingPanel" DockPanel.Dock="Bottom" LastChildFill="True" Margin="0,4,0,0">
        <Button Name="PreviousPageButton" DockPanel.Dock="Left" Width="Auto" Height="Auto" Padding="6,0" Content="&lt; Previous" ToolTip="Show the previous page of shelvesets" Command="{Binding Path=ParentSection.Pager.PreviousPageCommand}"/>
        <Button Name="NextPageButton" DockPanel.Dock="Left" Width="Auto" Height="Auto" Padding="6,0" Margin="4,0,0,0" Content="Next &gt;" ToolTip="Show the next page of shelvesets" Command="{Binding Path=ParentSection.Pager.NextPageCommand}"/>
        <TextBlock Name="PageText" DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Path=ParentSection.Pager.PageText}"/>
        <TextBlock Name="SelectionText" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Path=ParentSection.Pager.SelectionText}" ToolTip="{Binding Path=ParentSection.Pager.SelectionText}"/>
      </DockPanel>

      <!-- sorting goes through the pager, so that it sorts the shelvesets of all the pages -->
      <ListView x:Name="ListShelvesets" ItemsSource="{Binding Path=ParentSection.Pager.CurrentPage}" BorderThickness="0"
                    SelectionMode="Multiple" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    mvvm:FrameworkElementBehaviors.IgnoreMouseWheel="False"
                    MouseDoubleClick="ListShelvesets_MouseDoubleClick"
                    KeyUp="ListShelvesets_KeyUp"
                    SelectionChanged="ListShelvesetsSelectionChanged"
                    extensions:GridViewSorter.Command="{Binding Path=ParentSection.Pager.SortCommand}"
                    extensions:GridViewSorter.ShowSortGlyph="True"
                    DockPanel.Dock="Top">
        <ListView.View>
          <GridView>
            <GridViewColumn extensions:GridViewSorter.PropertyName="Name">
              <GridViewColumnHeader Content="Shelveset Name" HorizontalAlignment="Stretch" Tag="Name"/>
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <DockPanel>
                    <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding Path=IsExpanded, Mode=TwoWay}" ToolTip="Show the associated work items">
                      <!-- hidden rather than collapsed on shelvesets without work items, so that the
                           names of all the shelvesets stay aligned -->
                      <ToggleButton.Style>
                        <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource ExpandToggleButtonStyle}">
                          <Setter Property="Visibility" Value="Hidden" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=HasWorkItems}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ToggleButton.Style>
                    </ToggleButton>
                    <TextBlock Text="{Binding Path=Name}" VerticalAlignment="Center" />
                  </DockPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn extensions:GridViewSorter.PropertyName="CreationDate">
              <GridViewColumnHeader Content="Created On" HorizontalAlignment="Stretch" Tag="Date"/>
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Path=CreationDate, StringFormat={}{0:g}}"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn extensions:GridViewSorter.PropertyName="OwnerDisplayName">
              <GridViewColumnHeader Content="Owner" HorizontalAlignment="Stretch" Tag="OwnerName"/>
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Path=OwnerDisplayName}"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn extensions:GridViewSorter.PropertyName="ReviewersText" Width="160">
              <GridViewColumnHeader Content="Reviewers" HorizontalAlignment="Stretch" Tag="Reviewers"/>
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Path=ReviewersText}" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn extensions:GridViewSorter.PropertyName="Comment" Width="250">
              <GridViewColumnHeader Content="Comment" HorizontalAlignment="Stretch" Tag="Comment"/>
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Path=CommentFirstLine}" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
        <!-- the row details: the work items associated with the shelveset, listed under it when expanded -->
        <ListView.ItemTemplate>
          <DataTemplate>
            <ItemsControl ItemsSource="{Binding Path=WorkItems}" Margin="22,0,6,3" Visibility="{Binding Path=IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Path=DisplayText}" ToolTip="{Binding Path=AssignedTo}" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DataTemplate>
        </ListView.ItemTemplate>
        <ListView.ItemContainerStyle>
          <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Style.Triggers>
              <!-- the code reviews the signed in user is a reviewer of stand out -->
              <DataTrigger Binding="{Binding Path=IsAssignedToMe}" Value="True">
                <Setter Property="FontWeight" Value="Bold" />
              </DataTrigger>
            </Style.Triggers>
            <Setter Property="ToolTip">
              <Setter.Value>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,6,3" Text="Creation Date:" FontWeight="Bold"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,3" Text="{Binding Path=CreationDate, StringFormat={}{0:ddd dd MMM HH:mm}}"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,6,3" Text="Comment:" FontWeight="Bold"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,3" Text="{Binding Path=Comment}"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,6,3" Text="Work Items:" FontWeight="Bold" Visibility="{Binding Path=HasWorkItems, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                  <ItemsControl Grid.Row="2" Grid.Column="1" Margin="0,0,0,3" ItemsSource="{Binding Path=WorkItems}" DisplayMemberPath="DisplayText" Visibility="{Binding Path=HasWorkItems, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                  <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,6,3" Text="Reviewers:" FontWeight="Bold"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,3" Text="{Binding Path=ReviewersText}"/>
                </Grid>
              </Setter.Value>
            </Setter>
          </Style>
        </ListView.ItemContainerStyle>
      </ListView>
    </DockPanel>
  </Grid>
</UserControl>
  